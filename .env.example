# Required: device IP (LaMetric app -> Device Settings) and API key
# (developer.lametric.com -> My Devices)
LAMETRIC_HOST=
LAMETRIC_KEY=

# Optional. Codex-LB, a self-hosted load balancer in front of multiple Codex accounts.
# Without these values, the hub will not load the codex add-in.
CODEX_LB_URL=
CODEX_LB_PASSWORD=

# Optional. Delivery database from the private ai-usage-insights project.
# Without this value, the hub will not load the claude add-in.
# Use an absolute path; Compose does not expand tildes in volume paths.
AIUSAGE_DIR=
# The database is mounted at /aiusage in the container; locally, use the direct file path.
AIUSAGE_DB=

# Optional. Only this person's streams put the Plex logo on the clock face.
# Leave empty to count every active stream.
PLEX_WATCHER=

# Optional. Clock-face changes are irreversible because the current face cannot be read
# back. Enable them explicitly after reviewing the device notes.
CLOCKFACE=0

# Quiet hours by weekday, in local time. Empty (the default) never mutes anything;
# the line below is an example schedule, not a recommendation.
QUIET_HOURS=""
# QUIET_HOURS="mo-fr 00:00-09:00; sa,so 03:00-11:00"
# Allow critical events (broken build, Plex offline) during quiet hours?
QUIET_ALLOW_CRITICAL=0
# Send everything as critical outside quiet hours so notifications appear while the
# screensaver is active. Without this, the clock stays dark and shows nothing.
OVERRIDE_SCREENSAVER=1
# Timezone for quiet hours. Containers run on UTC unless this is set.
TZ=UTC

# Optional. Display names for Plex/Jellyfin/PSN logins, mounted read-only by Compose.
# Create it from assets/user_mapping.example.json; the real file is never committed.
USER_MAPPING_FILE=./assets/user_mapping.json
